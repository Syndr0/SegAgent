# Four RTX 3090 profile: Qwen on GPUs 0-2, VoxTell on GPU 3.
SEGAGENT_PLANNER=qwen
SEGAGENT_LLM_MODEL=Qwen/Qwen3.5-9B
SEGAGENT_ENABLE_THINKING=true

SEGAGENT_LLM_DEVICE=auto
SEGAGENT_LLM_INPUT_DEVICE=cuda:0
SEGAGENT_LLM_DEVICE_MAP=balanced_low_0
SEGAGENT_LLM_MAX_MEMORY={"0":"18GiB","1":"18GiB","2":"18GiB","cpu":"64GiB"}
SEGAGENT_VOXTELL_MODEL=/absolute/path/to/voxtell_v1.1
SEGAGENT_VOXTELL_DEVICE=cuda:3
SEGAGENT_VOXTELL_BATCH_SIZE=4

SEGAGENT_LLM_MAX_CONCURRENT_GENERATIONS=1
SEGAGENT_LLM_MAX_PROMPT_IMAGES=12
SEGAGENT_LLM_MAX_ARTIFACTS=2
SEGAGENT_LLM_MASK_AXIAL_VIEWS=1
SEGAGENT_LLM_MIN_IMAGE_TOKENS=256
SEGAGENT_LLM_MAX_IMAGE_TOKENS=512
SEGAGENT_MAX_NEW_TOKENS=1536
SEGAGENT_MONTAGE_SLICES=3

SEGAGENT_TRACE_CONTENT=false
SEGAGENT_API_BASE_URL=http://127.0.0.1:8000
SEGAGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
